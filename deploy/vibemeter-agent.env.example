# Template for /etc/vibemeter/agent.env — the EnvironmentFile read by
# deploy/vibemeter-agent.service. Variables are real; see AgentConfig.cs,
# AccessToken/DeviceCodeAuthOptions.cs and docs/agent-deployment.md.
#
# Install (as root), then edit:
#   sudo mkdir -p /etc/vibemeter
#   sudo install -o root -g root -m 600 deploy/vibemeter-agent.env.example /etc/vibemeter/agent.env
#   sudo chmod 600 /etc/vibemeter/agent.env   # must not be group/world readable
#   sudoedit /etc/vibemeter/agent.env
#
# Format: KEY=value, one per line. No "export". Values containing spaces must
# be quoted. Lines starting with # are comments; trailing comments on a value
# line are NOT supported — the # becomes part of the value. systemd re-reads
# this file only when the service (re)starts.
#
# Authentication — one of two modes, chosen by whether
# VIBEMETER_AGENT_CLIENT_ID is set:
#   - Device-code mode (CLIENT_ID set): the agent authenticates against Entra
#     via the MSAL device-code flow. VIBEMETER_AGENT_TOKEN is not required
#     and never read; all three VIBEMETER_AGENT_{CLIENT_ID,TENANT_ID,SCOPE}
#     variables are required. Run `VibeMeter.Agent --login` ONCE, as the
#     service user, to cache the credential — docs/agent-deployment.md §2.1.
#   - Environment-token mode (CLIENT_ID unset): VIBEMETER_AGENT_TOKEN is
#     required and re-read on every publish.

# Required in both modes. Collection API root; absolute http(s) only.
VIBEMETER_API_BASE_URL=https://api.example.com

# Required unless VIBEMETER_AGENT_CLIENT_ID is set (see above). Bearer token
# for the collection API. Treat this file as a secret while a real token is
# here: it is the only place the token exists on disk.
VIBEMETER_AGENT_TOKEN=replace-with-the-agent-bearer-token

# Device-code mode. Setting VIBEMETER_AGENT_CLIENT_ID opts in and makes the
# token above unnecessary; all three are then required at startup. For
# example: VIBEMETER_AGENT_SCOPE=api://<api-app-id>/Usage.Write — substitute
# the real ids; they are configuration, not secrets, but no real tenant,
# client or scope id belongs in this repository.
#VIBEMETER_AGENT_CLIENT_ID=<entra-application-client-id-of-the-agent's-public-client-registration>
#VIBEMETER_AGENT_TENANT_ID=<entra-directory-tenant-id>
#VIBEMETER_AGENT_SCOPE=api://<api-app-id>/Usage.Write

# Optional. Seconds between publish cycles. Default 300; minimum 10.
#VIBEMETER_AGENT_INTERVAL_SECONDS=300

# Optional. How old a provider's underlying data may be before the agent omits
# it from the snapshot. Default 20; minimum 1. See docs/agent.md.
#VIBEMETER_AGENT_STALENESS_MINUTES=20
