<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VibeMeter.Ui.ViewModels;assembly=VibeMeter.Ui"
        xmlns:models="clr-namespace:VibeMeter.Ui.Models;assembly=VibeMeter.Ui"
        xmlns:conv="clr-namespace:VibeMeter.Avalonia.Converters"
        x:Class="VibeMeter.Avalonia.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Vibe Meter Settings"
        Width="460" Height="640"
        MinWidth="420" MinHeight="420"
        Background="#252540">

    <Window.Resources>
        <conv:RgbToBrushConverter x:Key="RgbToBrush" />
        <conv:NonEmptyToBoolConverter x:Key="NonEmpty" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style Selector="Separator">
            <Setter Property="Margin" Value="0,12" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#40C2E8" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.soft">
            <Setter Property="Background" Value="#40FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.remove">
            <Setter Property="Background" Value="#40FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="Foreground" Value="#B0B0C0" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Styles>

    <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto">

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Vibe Meter" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Multi-provider AI usage monitor" FontSize="12" Foreground="#B0B0C0" />
        </StackPanel>

        <Separator Grid.Row="1" Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="2" Padding="0,0,10,0">
            <StackPanel>

                <TextBlock Classes="section" Text="Providers" />
                <ItemsControl ItemsSource="{Binding ProviderToggles}" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProviderToggle">
                            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                      Margin="0,3" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Separator />

                <!-- Tint: not in SettingsViewModel (the WPF app cycles it from
                     the main window); the window drives MainViewModel.TintIndex
                     directly and persists via SaveSettings. -->
                <Grid Margin="0,0,0,12" ColumnDefinitions="*,Auto">
                    <TextBlock Text="Tint" VerticalAlignment="Center" />
                    <ComboBox x:Name="TintCombo" Grid.Column="1" Width="160"
                              SelectionChanged="TintCombo_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:WidgetTint">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="10" Height="10"
                                             Fill="{Binding Primary, Converter={StaticResource RgbToBrush}}" />
                                    <TextBlock Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <CheckBox Content="Auto refresh while running"
                          IsChecked="{Binding AutoRefreshEnabled, Mode=TwoWay}"
                          Margin="0,0,0,12" />

                <Grid Margin="0,0,0,12" ColumnDefinitions="*,Auto">
                    <TextBlock Text="Refresh every" VerticalAlignment="Center" />
                    <!-- Avalonia ComboBox has no SelectedValuePath; the window
                         maps the chosen option to RefreshIntervalSeconds. -->
                    <ComboBox x:Name="RefreshIntervalCombo" Grid.Column="1" Width="140"
                              SelectionChanged="RefreshIntervalCombo_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:RefreshIntervalOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,0,0,12" ColumnDefinitions="*,Auto">
                    <TextBlock Text="Meter style" VerticalAlignment="Center" />
                    <ComboBox x:Name="MeterStyleCombo" Grid.Column="1" Width="140"
                              SelectionChanged="MeterStyleCombo_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:MeterStyleOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <CheckBox Content="Launch Vibe Meter at Login"
                          IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}" />

                <CheckBox Content="Keep widget always on top"
                          IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}" />

                <Separator />

                <Grid ColumnDefinitions="Auto,*">
                    <Button Classes="soft" Content="Refresh Now"
                            Command="{Binding RefreshCommand}" />
                    <TextBlock Grid.Column="1" Classes="secondary"
                               Text="{Binding LastUpdatedText}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>

                <Separator />

                <!-- Google accounts management -->
                <TextBlock Classes="section" Text="Google accounts" />
                <TextBlock Classes="secondary" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"
                           Text="Add multiple Google AI Pro accounts to cycle through on the Google card." />
                <ItemsControl x:Name="GoogleAccountsList" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GoogleAccountRow">
                            <Grid Margin="0,0,0,4" ColumnDefinitions="*,Auto">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Email}" FontSize="12" />
                                    <TextBlock Text="{Binding Note}" FontSize="10" Foreground="#FFB37C"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding HasNote}" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="remove" Content="Remove"
                                        Click="RemoveGoogleAccount_Click" Tag="{Binding Email}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="AddGoogleAccountButton" Classes="primary" Content="+ Add Google account"
                        Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,4"
                        Click="AddGoogleAccount_Click" />
                <TextBlock x:Name="GoogleAccountStatus" FontSize="11" Foreground="#B0B0C0" Margin="0,4,0,0"
                           TextWrapping="Wrap" />

                <Separator />

                <!-- Publishing to the collection API. Off by default. -->
                <TextBlock Classes="section" Text="Publish usage" />
                <TextBlock Classes="secondary" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"
                           Text="Sends this machine's provider states and percentages to the collection API after each refresh, so the companion mobile app can show them. Never your provider credentials. Off unless you turn it on." />

                <CheckBox Content="Publish this machine's usage after each refresh"
                          IsChecked="{Binding PublishEnabled, Mode=TwoWay}" Margin="0,0,0,8" />

                <TextBlock Classes="secondary" FontSize="11" Text="Collection API base URL" />
                <TextBox Text="{Binding PublishApiBaseUrl}" />

                <TextBlock Classes="secondary" FontSize="11" Text="Entra application (client) id" />
                <TextBox Text="{Binding PublishClientId}" />

                <TextBlock Classes="secondary" FontSize="11" Text="Entra directory (tenant) id" />
                <TextBox Text="{Binding PublishTenantId}" />

                <TextBlock Classes="secondary" FontSize="11" Text="Delegated scope" />
                <TextBox Text="{Binding PublishScope}" />

                <TextBlock Classes="secondary" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"
                           Text="Signing in uses a device code: the first publish shows a short code in the error log (Avalonia has no tray balloon), which you enter on another device or in a browser. Nothing blocks while you do." />

                <TextBlock Classes="secondary" FontSize="11" Text="{Binding PublishStatusText}"
                           TextWrapping="Wrap" Margin="0,0,0,4" />

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Classes="primary" Content="Save &amp; Close" Click="SaveClose_Click" />
        </StackPanel>

    </Grid>
</Window>
