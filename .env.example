# VibeMeter environment variables — reference template.
#
# Copy this file to ".env" and fill in real values if you want a local secret
# store. The ".env" file is git-ignored and will never be committed.
#
# IMPORTANT: VibeMeter reads these from your SYSTEM environment at runtime
# (e.g. setx ZAI_API_KEY "..." or System > Environment Variables), NOT from this
# file. This template exists only to document the variables and to keep a local
# copy out of source control. See .gitignore (".env" is ignored).

# Z.ai GLM coding plan key — enables live Z.ai quota gauges.
ZAI_API_KEY=

# Fallback key some Z.ai / Anthropic-compatible setups use instead of ZAI_API_KEY.
ANTHROPIC_AUTH_TOKEN=
