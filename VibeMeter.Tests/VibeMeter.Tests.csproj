<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real files captured from the machines this provider actually runs on, so the
         source-selection tests exercise the production readers rather than hand-built
         objects. Copied verbatim; windows-usage_cache-bom.json keeps its UTF-8 BOM. -->
    <Content Include="Providers\Claude\Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VibeMeter.Agent\VibeMeter.Agent.csproj" />
    <ProjectReference Include="..\VibeMeter.Core\VibeMeter.Core.csproj" />
    <ProjectReference Include="..\VibeMeter.Publishing\VibeMeter.Publishing.csproj" />
  </ItemGroup>

</Project>
