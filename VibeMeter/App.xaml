<Application x:Class="VibeMeter.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VibeMeter"
             xmlns:views="clr-namespace:VibeMeter.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <FontFamily x:Key="AppFont">Segoe UI</FontFamily>

        <Color x:Key="PanelBackgroundColor">#CC1A1A2E</Color>
        <Color x:Key="CardBackgroundColor">#40FFFFFF</Color>
        <Color x:Key="ThinCardBackgroundColor">#20FFFFFF</Color>
        <Color x:Key="PrimaryTextColor">#FFFFFF</Color>
        <Color x:Key="SecondaryTextColor">#B0B0C0</Color>
        <Color x:Key="AccentColor">#40C2E8</Color>
        <Color x:Key="BorderColor">#38FFFFFF</Color>

        <SolidColorBrush x:Key="PanelBackground" Color="{StaticResource PanelBackgroundColor}"/>
        <SolidColorBrush x:Key="CardBackground" Color="{StaticResource CardBackgroundColor}"/>
        <SolidColorBrush x:Key="ThinCardBackground" Color="{StaticResource ThinCardBackgroundColor}"/>
        <SolidColorBrush x:Key="PrimaryText" Color="{StaticResource PrimaryTextColor}"/>
        <SolidColorBrush x:Key="SecondaryText" Color="{StaticResource SecondaryTextColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    </Application.Resources>
</Application>
