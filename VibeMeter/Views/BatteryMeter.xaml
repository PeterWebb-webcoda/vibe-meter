<UserControl x:Class="VibeMeter.Views.BatteryMeter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ToolTip="{Binding TooltipText}">
    <Border CornerRadius="8" Background="#30FFFFFF" Padding="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                        HorizontalAlignment="Left" Margin="0,0,12,0">
                <TextBlock x:Name="TitleText"
                           FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                           Foreground="White" />
                <TextBlock x:Name="SubtitleText"
                           FontFamily="Segoe UI" FontSize="10"
                           Foreground="#B0B0C0" Margin="0,2,0,0" />
                <TextBlock x:Name="ResetTextBlock"
                           FontFamily="Segoe UI" FontSize="9"
                           Foreground="#B0B0C0" Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Border Width="112" Height="38" CornerRadius="9"
                        BorderBrush="#2EFFFFFF" BorderThickness="1"
                        Background="#12FFFFFF">
                    <Grid>
                        <Border x:Name="FillBorder" CornerRadius="5"
                                Margin="5" HorizontalAlignment="Left">
                            <Border.Background>
                                <SolidColorBrush x:Name="FillBrush" Color="Transparent" />
                            </Border.Background>
                        </Border>
                        <TextBlock x:Name="PercentText"
                                   FontFamily="Segoe UI" FontSize="15" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Rectangle Width="5" Height="18" RadiusX="2" RadiusY="2"
                           Fill="#38FFFFFF" Margin="2,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
