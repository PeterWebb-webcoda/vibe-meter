<Window x:Class="VibeMeter.Views.CostDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:claude="clr-namespace:VibeMeter.Providers.Claude"
        mc:Ignorable="d"
        Title="Cost Details"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Width="360" Height="500"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border CornerRadius="16" Background="#EB1A1A2E" BorderBrush="#40FFFFFF" BorderThickness="1" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Claude Code Breakdown" FontSize="16" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                        Click="CloseButton_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="#A0FFFFFF" FontSize="14" Padding="8,4">✕</Button>
            </DockPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#20FFFFFF" CornerRadius="10" Padding="12" Margin="0,0,10,0" Width="100">
                        <StackPanel>
                            <TextBlock Text="Today" FontSize="11" Foreground="#B0B0C0"/>
                            <TextBlock Text="{Binding TodayTotalCostUsd, StringFormat=${0:F2}}" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding TodayTotalTokens, StringFormat={}{0:N0} billed tokens}" FontSize="10" Foreground="#808090"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#20FFFFFF" CornerRadius="10" Padding="12" Margin="0,0,10,0" Width="100">
                        <StackPanel>
                            <TextBlock Text="5-Hour" FontSize="11" Foreground="#B0B0C0"/>
                            <TextBlock Text="{Binding FiveHourCostUsd, StringFormat=${0:F2}}" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding FiveHourTokens, StringFormat={}{0:N0} billed tokens}" FontSize="10" Foreground="#808090"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#20FFFFFF" CornerRadius="10" Padding="12" Width="100">
                        <StackPanel>
                            <TextBlock Text="7 Days" FontSize="11" Foreground="#B0B0C0"/>
                            <TextBlock Text="{Binding WeekTotalCostUsd, StringFormat=${0:F2}}" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding WeekTotalTokens, StringFormat={}{0:N0} billed tokens}" FontSize="10" Foreground="#808090"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <!-- Headline token definition: billed tokens EXCLUDE near-free cache reads, so the
                     figure tracks spend and matches the Codex panel for honest comparison (Bug 3). -->
                <TextBlock Text="Billed tokens exclude cache reads (≈ free reuse). Cache breakdown below."
                            FontSize="9" Foreground="#707080" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Weekly cache metrics strip -->
            <Border Grid.Row="2" Background="#1860C873" CornerRadius="10" Padding="10,8" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="Cache read" FontSize="9" Foreground="#80C8A0" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding WeekCacheReadTokens, StringFormat={}{0:N0}}" FontSize="13" FontWeight="Bold" Foreground="#60C873" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="│" Foreground="#30FFFFFF" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="Cache write" FontSize="9" Foreground="#80A0C8" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding WeekCacheWriteTokens, StringFormat={}{0:N0}}" FontSize="13" FontWeight="Bold" Foreground="#60A0C8" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="│" Foreground="#30FFFFFF" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                        <TextBlock Text="Re-processed" FontSize="9" Foreground="#9090A0" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding WeekUncachedInputTokens, StringFormat={}{0:N0}}" FontSize="13" FontWeight="Bold" Foreground="#C0C0D0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Weekly usage by model" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding WeeklyModelCosts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type claude:ClaudeModelCost}">
                                <Border Background="#10FFFFFF" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ModelId}" FontSize="12" Foreground="White" FontWeight="SemiBold"/>
                                                <!-- Estimated-rate marker: shown when the model fell through the
                                                     rate table to an estimated fallback (Bug 2 / Bug 4). -->
                                                <TextBlock Text=" ⓘ est. rate" FontSize="9" Foreground="#E0B040"
                                                            VerticalAlignment="Bottom" Margin="4,0,0,1"
                                                            Visibility="{Binding IsEstimatedRate, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                            <TextBlock FontSize="10" Foreground="#9090A0" Margin="0,4,0,0">
                                                <Run Text="In: "/><Run Text="{Binding InputTokens, StringFormat=N0}"/>
                                                <Run Text=" | Out: "/><Run Text="{Binding OutputTokens, StringFormat=N0}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="10" Foreground="#60C873" Margin="0,2,0,0">
                                                <Run Text="Cache read: "/><Run Text="{Binding CacheReadTokens, StringFormat=N0}"/>
                                                <Run Text=" · write: "/><Run Text="{Binding CacheWriteTokens, StringFormat=N0}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalCostUsd, StringFormat=${0:F2}}" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <TextBlock Grid.Row="4" FontSize="10" Foreground="#606070" HorizontalAlignment="Center" Margin="0,10,0,0" TextAlignment="Center">
                API-equivalent estimate; subscription cost may differ.<LineBreak/>
                Rates verified 31/07/2026. Rows marked ⓘ use fallback pricing.
            </TextBlock>
        </Grid>
    </Border>
</Window>
