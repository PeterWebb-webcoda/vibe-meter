<Window x:Class="VibeMeter.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VibeMeter.ViewModels"
        mc:Ignorable="d"
        Title="Vibe Meter Settings"
        Height="520" Width="460"
        WindowStartupLocation="CenterScreen"
        Background="#252540"
        Foreground="White"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Vibe Meter" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Multi-provider AI usage monitor" FontSize="12" Foreground="#B0B0C0"/>
        </StackPanel>

        <Border Grid.Row="1" Height="1" Background="#38FFFFFF" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="2">

            <TextBlock Text="Providers" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ItemsControl ItemsSource="{Binding ProviderToggles}" Margin="0,0,0,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ProviderToggle}">
                        <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsEnabled}" Margin="0,3"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Height="1" Background="#38FFFFFF" Margin="0,0,0,12"/>

            <CheckBox Content="Auto refresh while running"
                      IsChecked="{Binding AutoRefreshEnabled}" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Refresh every" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" Width="120"
                          ItemsSource="{Binding RefreshIntervals}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Seconds"
                          SelectedValue="{Binding RefreshIntervalSeconds}"/>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Meter style" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" Width="120"
                          ItemsSource="{Binding MeterStyles}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Style"
                          SelectedValue="{Binding MeterStyle}"/>
            </Grid>

            <CheckBox Content="Launch Vibe Meter at Login"
                      IsChecked="{Binding LaunchAtStartup}"/>

            <CheckBox Content="Keep widget always on top"
                      IsChecked="{Binding AlwaysOnTop}"/>

            <Border Height="1" Background="#38FFFFFF" Margin="0,8"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="Refresh Now" Padding="12,6"
                        Command="{Binding RefreshCommand}"
                        Background="#40FFFFFF" Foreground="White" BorderThickness="0"/>

                <TextBlock Grid.Column="2"
                           Text="{Binding LastUpdatedText}"
                           Foreground="#B0B0C0"
                           VerticalAlignment="Center"/>
            </Grid>

        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save &amp; Close" Padding="16,6"
                    Click="SaveClose_Click"
                    Background="#40C2E8" Foreground="Black" FontWeight="SemiBold" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
