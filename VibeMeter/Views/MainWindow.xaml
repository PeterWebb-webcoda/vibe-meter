<Window x:Class="VibeMeter.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VibeMeter.Views"
        xmlns:vm="clr-namespace:VibeMeter.ViewModels"
        xmlns:models="clr-namespace:VibeMeter.Models"
        mc:Ignorable="d"
        Title="Vibe Meter"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="{Binding AlwaysOnTop}"
        Loaded="Window_Loaded"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- All sizing is managed in code-behind (ApplyCompactLayout). -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:PercentToWidthConverter x:Key="PctToWidth" />

        <DataTemplate x:Key="CircularMeterTemplate" DataType="{x:Type models:UsageGaugeData}">
            <local:CircularMeter Gauge="{Binding}" Margin="0,2"/>
        </DataTemplate>
        <DataTemplate x:Key="HorizontalMeterTemplate" DataType="{x:Type models:UsageGaugeData}">
            <local:BarMeter Gauge="{Binding}" Margin="0,4"/>
        </DataTemplate>
        <DataTemplate x:Key="BatteryMeterTemplate" DataType="{x:Type models:UsageGaugeData}">
            <local:BatteryMeter Gauge="{Binding}" Margin="0,4"/>
        </DataTemplate>

        <local:MeterStyleTemplateSelector x:Key="MeterTemplateSelector"
                                          CircularTemplate="{StaticResource CircularMeterTemplate}"
                                          HorizontalTemplate="{StaticResource HorizontalMeterTemplate}"
                                          BatteryTemplate="{StaticResource BatteryMeterTemplate}"/>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#30FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#50FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#20FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MicroButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#30FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#50FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#20FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One compact cell in the micro-bar: provider label + 5h/weekly sections with reset countdown. -->
        <DataTemplate x:Key="CompactCellTemplate" DataType="{x:Type vm:ProviderViewModel}">
            <Border Margin="3,0" Padding="8,4" CornerRadius="8" Background="#10FFFFFF"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasGauges, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <!-- Provider short name -->
                    <DockPanel Margin="0,0,0,4">
                        <Ellipse Width="8" Height="8" Fill="{Binding AccentBrush}"
                                 DockPanel.Dock="Left" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ShortName}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#A0FFFFFF" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Two gauge sections side by side -->
                    <StackPanel Orientation="Horizontal">
                        <!-- 5h section -->
                        <StackPanel Width="64" Margin="0,0,6,0" ToolTip="{Binding FiveHourTooltip}">
                            <DockPanel>
                                <TextBlock Text="5h" FontSize="9" Foreground="#80FFFFFF"
                                           DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding FiveHourReset}" FontSize="8"
                                           Foreground="#60FFFFFF" HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <Grid Height="4" Margin="0,2,0,0">
                                <Border Background="#20FFFFFF" CornerRadius="2"/>
                                <Border Background="{Binding AccentBrush}" CornerRadius="2"
                                        HorizontalAlignment="Left"
                                        Width="{Binding FiveHourPercent, Converter={StaticResource PctToWidth}, ConverterParameter=64}"/>
                            </Grid>
                        </StackPanel>

                        <!-- Weekly section -->
                        <StackPanel Width="64" ToolTip="{Binding WeeklyTooltip}">
                            <DockPanel>
                                <TextBlock Text="Wk" FontSize="9" Foreground="#80FFFFFF"
                                           DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding WeeklyReset}" FontSize="8"
                                           Foreground="#60FFFFFF" HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <Grid Height="4" Margin="0,2,0,0">
                                <Border Background="#20FFFFFF" CornerRadius="2"/>
                                <Border Background="{Binding AccentBrush}" CornerRadius="2"
                                        HorizontalAlignment="Left"
                                        Width="{Binding WeeklyPercent, Converter={StaticResource PctToWidth}, ConverterParameter=64}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- ============ FULL PANEL ============ -->
        <Border CornerRadius="26"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CompactMode}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <DockPanel Margin="16">

                <!-- Header -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="Vibe Meter"
                                   FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryText}"/>
                        <TextBlock Text="AI usage across Codex, Claude, Z.ai &amp; Google"
                                   FontSize="11"
                                   Foreground="{StaticResource SecondaryText}"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding RefreshCommand}"
                                ToolTip="Refresh" Margin="0,0,8,0">
                            <TextBlock Text="↻" FontSize="16" FontFamily="Segoe UI Symbol"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}"
                                Click="ResetPositionButton_Click"
                                ToolTip="Reset Position" Margin="0,0,8,0">
                            <TextBlock Text="⊞" FontSize="16" FontFamily="Segoe UI Symbol"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding ToggleCompactCommand}"
                                ToolTip="Compact mode" Margin="0,0,8,0">
                            <TextBlock Text="▭" FontSize="13" FontFamily="Segoe UI Symbol"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}"
                                Click="SettingsButton_Click"
                                ToolTip="Settings" Margin="0,0,8,0">
                            <TextBlock Text="⚙" FontSize="16" FontFamily="Segoe UI Symbol"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}"
                                Click="HideButton_Click"
                                ToolTip="Hide">
                            <TextBlock Text="✕" FontSize="14" FontFamily="Segoe UI Symbol"/>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- Footer -->
                <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Command="{Binding CycleTintCommand}"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <StackPanel Orientation="Horizontal" Background="Transparent">
                                        <Ellipse Width="8" Height="8" Fill="{Binding TintPrimaryBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding CurrentTint.Name}"
                                                   FontSize="11" Foreground="{StaticResource SecondaryText}"/>
                                    </StackPanel>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock Text=" · " Foreground="{StaticResource SecondaryText}" FontSize="11"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="11" Foreground="{StaticResource SecondaryText}"/>
                    </StackPanel>
                </DockPanel>

                <!-- Provider cards -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Providers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProviderViewModel}">
                                <Border CornerRadius="12" Background="#18FFFFFF"
                                        Padding="14" Margin="0,0,0,12">

                                    <StackPanel>
                                        <!-- Card header -->
                                        <DockPanel Margin="0,0,0,10">
                                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="10" Height="10"
                                                         Fill="{Binding AccentBrush}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="15" FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryText}"/>
                                            </StackPanel>

                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <!-- Plan badge -->
                                                <Border Background="#20FFFFFF" CornerRadius="10" Padding="8,2" Margin="0,0,8,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PlanLabel}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding PlanLabel}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding PlanLabel}" FontSize="10"
                                                               Foreground="{StaticResource PrimaryText}"/>
                                                </Border>

                                                <!-- Available-credits badge -->
                                                <Border Background="#3040C873" CornerRadius="10" Padding="8,2"
                                                        Visibility="{Binding ShowResetBank, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="{Binding ResetCreditsTooltip}"
                                                        Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding AvailableCount}" FontSize="10"
                                                                   Foreground="#40C873" FontWeight="SemiBold"/>
                                                        <TextBlock Text=" available" FontSize="10" Foreground="#40C873"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Details button -->
                                                <Button Background="Transparent" BorderBrush="#38FFFFFF" BorderThickness="1"
                                                        Foreground="{StaticResource PrimaryText}" Padding="8,2" Margin="8,0,0,0"
                                                        Visibility="{Binding ShowDetailsButton, Converter={StaticResource BoolToVis}}"
                                                        Click="DetailsButton_Click" Cursor="Hand">
                                                    <TextBlock Text="Cost breakdown" FontSize="10"/>
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#30FFFFFF"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Gauges -->
                                        <ItemsControl ItemsSource="{Binding Gauges}"
                                                      ItemTemplateSelector="{StaticResource MeterTemplateSelector}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>

                                        <!-- Cost Panel -->
                                        <Border Background="#10FFFFFF" CornerRadius="8" Padding="12" Margin="0,12,0,0"
                                                Visibility="{Binding HasCostData, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <!-- Total Costs -->
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="💰" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TodayCostText}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding WeekCostText}" FontSize="11" Foreground="{StaticResource SecondaryText}"/>
                                                            <TextBlock Text=" • " FontSize="11" Foreground="{StaticResource SecondaryText}"/>
                                                            <TextBlock Text="{Binding TodayTokensText}" FontSize="11" Foreground="{StaticResource SecondaryText}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Model Breakdown -->
                                                <ItemsControl ItemsSource="{Binding CostModelBreakdowns}" Margin="0,16,0,0" Grid.IsSharedSizeScope="True">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ModelName"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                
                                                                <TextBlock Grid.Column="0" Text="{Binding ModelName}" FontSize="11" Foreground="{StaticResource SecondaryText}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                
                                                                <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Percentage100, Mode=OneWay}" Height="6" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                    <ProgressBar.Template>
                                                                        <ControlTemplate TargetType="ProgressBar">
                                                                            <Border Background="#20FFFFFF" CornerRadius="3" x:Name="PART_Track">
                                                                                <Border Background="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CornerRadius="3" HorizontalAlignment="Left" x:Name="PART_Indicator" />
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </ProgressBar.Template>
                                                                </ProgressBar>
                                                                
                                                                <TextBlock Grid.Column="2" Text="{Binding CostText}" FontSize="11" Foreground="{StaticResource PrimaryText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Reset note -->
                                        <TextBlock Text="{Binding ResetNote}"
                                                   FontSize="11" Foreground="{StaticResource SecondaryText}"
                                                   HorizontalAlignment="Center" Margin="0,8,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ResetNote}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Not configured -->
                                        <Border Background="#20FFFFFF" CornerRadius="8" Padding="10" Margin="0,8,0,0"
                                                Visibility="{Binding ShowNotConfigured, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding ErrorMessage}" FontSize="11"
                                                       Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                                        </Border>

                                        <!-- Error -->
                                        <Border Background="#30482020" CornerRadius="8" Padding="10" Margin="0,8,0,0"
                                                Visibility="{Binding ShowError, Converter={StaticResource BoolToVis}}">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" VerticalAlignment="Top"
                                                        Click="CopyErrorButton_Click" ToolTip="Copy error message"
                                                        Background="Transparent" BorderBrush="#40F04840"
                                                        BorderThickness="1" Cursor="Hand"
                                                        Padding="6,1" Margin="8,0,0,0">
                                                    <TextBlock Text="Copy" FontSize="10" Foreground="#F04840"/>
                                                </Button>
                                                <TextBlock Text="{Binding ErrorMessage}" FontSize="11"
                                                           Foreground="#F04840" TextWrapping="Wrap"/>
                                            </DockPanel>
                                        </Border>

                                        <!-- Status line -->
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="10" Foreground="{StaticResource SecondaryText}"
                                                   HorizontalAlignment="Right" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <!-- ============ COMPACT MICRO-BAR ============ -->
        <Border CornerRadius="14"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Padding="8,6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CompactMode}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource MicroButtonStyle}"
                        Command="{Binding ToggleCompactCommand}"
                        ToolTip="Expand"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0">
                    <TextBlock Text="⤢" FontSize="13" FontFamily="Segoe UI Symbol" Foreground="White"/>
                </Button>

                <ItemsControl ItemsSource="{Binding Providers}"
                              ItemTemplate="{StaticResource CompactCellTemplate}"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </DockPanel>
        </Border>
    </Grid>
</Window>
