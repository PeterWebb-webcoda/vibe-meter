<UserControl x:Class="VibeMeter.Views.BarMeter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="4,4,4,8" MinWidth="180"
             ToolTip="{Binding TooltipText}">
    <StackPanel>
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TitleText" Grid.Column="0"
                       FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center" />
            
            <TextBlock x:Name="SubtitleText" Grid.Column="1"
                       FontFamily="Segoe UI" FontSize="10"
                       Foreground="#B0B0C0" VerticalAlignment="Center"
                       Margin="6,0,0,0" />
                       
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="PercentText"
                           FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                           Foreground="White" />
                <TextBlock Text="%"
                           FontFamily="Segoe UI" FontSize="9"
                           Foreground="#B0B0C0" Margin="1,2,0,0"/>
            </StackPanel>
        </Grid>

        <Grid Height="6">
            <Rectangle RadiusX="3" RadiusY="3" Fill="#15FFFFFF" />
            <Rectangle x:Name="FillBar" RadiusX="3" RadiusY="3"
                       HorizontalAlignment="Left" />
        </Grid>

        <TextBlock x:Name="ResetTextBlock"
                   FontFamily="Segoe UI" FontSize="9"
                   Foreground="#808090" Margin="0,4,0,0"
                   HorizontalAlignment="Right" />
    </StackPanel>
</UserControl>
