<UserControl x:Class="VibeMeter.Views.BarMeter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border CornerRadius="8" Background="#30FFFFFF" Padding="12">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TitleText" Grid.Column="0"
                           FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Left"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="SubtitleText" Grid.Column="1"
                           FontFamily="Segoe UI" FontSize="11"
                           Foreground="#B0B0C0" HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="PercentText" Grid.Column="2"
                           FontFamily="Segoe UI" FontSize="18" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>

            <Grid Height="12" Margin="0,8,0,0">
                <Rectangle RadiusX="6" RadiusY="6" Fill="#1CFFFFFF" />
                <Rectangle x:Name="FillBar" RadiusX="6" RadiusY="6"
                           HorizontalAlignment="Left" />
            </Grid>

            <TextBlock x:Name="ResetTextBlock"
                       FontFamily="Segoe UI" FontSize="11"
                       Foreground="#B0B0C0" Margin="0,6,0,0" />
        </StackPanel>
    </Border>
</UserControl>
