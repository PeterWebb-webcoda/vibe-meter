<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>VibeMeter</RootNamespace>
    <AssemblyName>VibeMeter</AssemblyName>
    <Version>0.5.0</Version>
    <Company>WebCoda</Company>
    <Product>VibeMeter</Product>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Release packaging: self-contained single-file exe (publish -r win-x64). -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VibeMeter.Core\VibeMeter.Core.csproj" />
    <!-- Opt-in publishing to the collection API, shared verbatim with the
         headless agent. The library is deliberately platform-neutral (net10.0),
         so referencing it costs this WPF app nothing but the MSAL dependency. -->
    <ProjectReference Include="..\VibeMeter.Publishing\VibeMeter.Publishing.csproj" />
  </ItemGroup>

</Project>
