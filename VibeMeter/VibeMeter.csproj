<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>VibeMeter</RootNamespace>
    <AssemblyName>VibeMeter</AssemblyName>
    <Version>0.2.0</Version>
    <Company>WebCoda</Company>
    <Product>VibeMeter</Product>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Release packaging: self-contained single-file exe (publish -r win-x64). -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <!-- Reads Antigravity's OAuth refresh token from its state.vscdb (SQLite). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- Pin the patched native SQLite (3.50.2+) to clear CVE-2025-6965; the transitive
         default (2.1.x) bundles a vulnerable SQLite. We only run a single read-only
         SELECT, so the practical risk is nil, but a clean build is better. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
  </ItemGroup>

</Project>
