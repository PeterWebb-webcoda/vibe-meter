<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Lets the solution restore and compile on Linux, so `dotnet build VibeMeter.slnx`
         works everywhere. Producing a runnable build still requires Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>VibeMeter</RootNamespace>
    <AssemblyName>VibeMeter</AssemblyName>
    <Version>0.5.3</Version>
    <Company>WebCoda</Company>
    <Product>VibeMeter</Product>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Release packaging: self-contained single-file exe (publish -r win-x64). -->
  <PropertyGroup>
    <!-- SelfContained makes the SDK resolve a RuntimeIdentifier, and with none named it
         picks the host's. On Linux that asks for a WindowsDesktop runtime pack for
         linux-x64, which does not exist (NETSDK1082) - so the solution build failed there
         even with EnableWindowsTargeting set. Naming the RID the release workflow already
         publishes with keeps every platform resolving the same, real pack. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VibeMeter.Core\VibeMeter.Core.csproj" />
    <!-- Opt-in publishing to the collection API, shared verbatim with the
         headless agent. The library is deliberately platform-neutral (net10.0),
         so referencing it costs this WPF app nothing but the MSAL dependency. -->
    <ProjectReference Include="..\VibeMeter.Publishing\VibeMeter.Publishing.csproj" />
    <!-- Shared UI logic (view models, models, services), platform-neutral so a
         future Avalonia app can reference the same library. CommunityToolkit.Mvvm
         now flows from here; the brushes the XAML binds to are produced at the
         rendering edge by RgbToBrushConverter / RgbExtensions. -->
    <ProjectReference Include="..\VibeMeter.Ui\VibeMeter.Ui.csproj" />
  </ItemGroup>

</Project>
